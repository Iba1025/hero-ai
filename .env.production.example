# Hero.AI production environment — LEAN MODE (Phase 6, DEC-27/28/29/30).
# Copy to .env.production on the server, fill in real values, chmod 600.
# NEVER commit the filled file; it never enters git or the image.
#
# Two kinds of vars live here:
#   1. Compose interpolation vars (passwords/domain) read by docker-compose.yml
#   2. App vars (spec §3, src/hero/config.py) injected into the api container
#
# NOT set here (compose owns intra-network wiring; see docker-compose.yml):
#   DATABASE_URL, QDRANT_URL, LANGFUSE_HOST
#
# Generate secrets with:  openssl rand -hex 32

# ══ 1. Compose / infrastructure ═══════════════════════════════════════════

# ── Edge (Caddy) ──────────────────────────────────────────────────────────
# Local loop: http://localhost (plain HTTP). Server: bare domain → auto-HTTPS.
SITE_ADDRESS=http://localhost
ACME_EMAIL=you@example.com

# ── Postgres 16 ───────────────────────────────────────────────────────────
POSTGRES_USER=hero
POSTGRES_PASSWORD=
POSTGRES_DB=hero

# ══ 2. Application (spec §3 — src/hero/config.py) ═════════════════════════

# ── R2 / S3 object storage (INV-3: presigning only) ───────────────────────
# DEC-28: R2 with NA location hint for the pilot; migration to Canadian-region
# S3-compatible storage is REQUIRED before any procurement review or paying
# customer. Region stays "auto" for R2.
R2_ENDPOINT=
R2_BUCKET=hero-media
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_REGION=auto

# ── Cloudflare Workers AI — lean-mode embed/rerank (pilot variant) ────────
# ⚠️ RECORDED INV-2 EXCEPTION (founder-approved 2026-07-30, pending DEC
# number; docs/residency.md is the audit record): Workers AI has no Canadian
# residency commitment. bge-m3 embeddings + bge-reranker-base. The token
# needs Workers AI permission — R2 S3 keys cannot call it. Account id is the
# hex host segment of R2_ENDPOINT.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── AWS Bedrock — lean-mode embed/rerank (DEC-29, INV-2-clean target) ─────
# ca-central-1 keeps INV-2 clean: Cohere Embed Multilingual v3 (in-region)
# + Cohere Rerank 3.5 (in-region). Auth = long-term Bedrock API key.
# Unused while the Cloudflare exception stands; the migration target.
BEDROCK_REGION=ca-central-1
AWS_BEARER_TOKEN_BEDROCK=

# ── Langfuse — DEFERRED from the pilot box (DEC-30) ──────────────────────
# Leave all three unset: tracing is then a verified no-op
# (src/hero/observability/tracing.py). Reinstate trigger = DEC-29 reversion.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=

# ── VLM tiered routing (DEC-18) + provider keys ───────────────────────────
VLM_MODEL_PRIMARY=claude-fable-5
VLM_MODEL_VERIFY=claude-sonnet-4-6
VLM_MODEL_FALLBACK=gpt-4o
# Empty = verify tier handles TRIAGE (DEC-18 as amended)
VLM_MODEL_TRIAGE=
# Nova conversational tier (DEC-23) — haiku-class
VLM_MODEL_CHAT=claude-haiku-4-5-20251001
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── Adapter selectors (BL-19/H3: going live is an env change) ─────────────
# LEAN MODE: 'cloudflare' = Workers AI (recorded INV-2 exception);
# 'bedrock_cohere'/'cohere' = Bedrock ca-central-1 (INV-2 clean, DEC-29).
# Self-hosted reversion = colmodernvbert/bge + `uv sync --extra selfhosted`.
EMBEDDER_IMPL=cloudflare
RERANKER_IMPL=cloudflare
CALIBRATOR_IMPL=platt
VLM_IMPL=litellm

# ── Auth (P4-1) ───────────────────────────────────────────────────────────
# Empty JWT_SECRET_KEY = all authenticated endpoints return 503 (fail loudly).
JWT_SECRET_KEY=
JWT_EXPIRY_SECONDS=43200
# True in production — the session cookie only travels over HTTPS.
AUTH_COOKIE_SECURE=true
# The SPA is same-origin behind Caddy; set this to the site origin anyway so
# credentialed CORS never silently widens. e.g. https://hero.example.ca
CORS_ORIGINS=http://localhost

# ── Public tenant intake — abuse basics (P4-4 / BL-15) ────────────────────
PUBLIC_INTAKE_RATE_PER_HOUR=10
PUBLIC_PRESIGN_RATE_PER_HOUR=30
PUBLIC_ANSWER_RATE_PER_HOUR=20
PUBLIC_MESSAGE_RATE_PER_HOUR=60
PUBLIC_MAX_PHOTOS=6
PUBLIC_MAX_PHOTO_BYTES=10485760

# ── Nova conversational intake (DEC-23/24) ────────────────────────────────
NOVA_MAX_REPLY_TOKENS=300
NOVA_MAX_MESSAGES=30
NOVA_COST_CEILING_USD=0.25

# ── Retrieval / verification tuning (BL-6/DEC-6, BL-9/DEC-11) ─────────────
GROUNDING_THRESHOLD=0.8
GROUNDING_THRESHOLD_STRICT=1.0
MAX_CLARIFY_ROUNDS=3
MAX_CORRECTIVE_ROUNDS=2
CORRECTIVE_TIMEOUT_S=10.0

# ── Dev-only flags — NEVER set in production (INV-6) ──────────────────────
# HERO_EVAL_MEMORY_CHECKPOINTER must stay unset.
